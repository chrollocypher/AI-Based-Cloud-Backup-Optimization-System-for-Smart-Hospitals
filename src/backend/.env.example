PROJECT_NAME="Smart Hospital Cloud Backup Optimization Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# AWS Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
USE_MOCK_AWS=True

# DynamoDB Tables
DYNAMODB_TABLE_RECORDS="SmartHospitalRecords"
DYNAMODB_TABLE_JOBS="SmartHospitalBackupJobs"

# AWS Step Functions & SageMaker
STEP_FUNCTION_ARN="arn:aws:states:us-east-1:123456789012:stateMachine:SmartHospitalBackupPipeline"
SAGEMAKER_ENDPOINT_NAME=""

# System Capacity Thresholds
CAPACITY_THRESHOLD_MB=10000.0
